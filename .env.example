# TripSync — copy to `.env.local` and fill in values.
# Never commit `.env.local` (secrets).

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Database (Neon) — required Phase 0
# https://neon.tech → Project → Connection string
# -----------------------------------------------------------------------------
DATABASE_URL=

# -----------------------------------------------------------------------------
# Auth.js — required Phase 0
# Generate: openssl rand -base64 32
# -----------------------------------------------------------------------------
AUTH_SECRET=

# --- Option A: Google only (minimal Phase 0) ---
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Option B: Google + email magic link (add when enabling email login) ---
# https://resend.com → API Keys
# AUTH_RESEND_KEY=
# EMAIL_FROM=noreply@your-verified-domain.com

# -----------------------------------------------------------------------------
# Pusher Channels — required Phase 0
# https://dashboard.pusher.com → App Keys
# -----------------------------------------------------------------------------
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=

# -----------------------------------------------------------------------------
# Phase 1 — uncomment when starting Itinerary / Group Hub features
# -----------------------------------------------------------------------------
# Mapbox: https://account.mapbox.com/access-tokens/
# NEXT_PUBLIC_MAPBOX_TOKEN=

# Cloudflare R2 (image pins): https://dash.cloudflare.com → R2
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_URL=
